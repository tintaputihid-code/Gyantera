# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# Database (SQLite untuk dev, ganti ke PostgreSQL untuk production)
DATABASE_URL="file:./dev.db"
# Contoh PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/platform_apps"

# JWT
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# Midtrans (ambil dari dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false